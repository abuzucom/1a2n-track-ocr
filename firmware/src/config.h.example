// Copy this file to config.h and fill in real values. config.h is
// gitignored; never commit it.

#pragma once

// How often to sample the screen, in milliseconds. Track changes happen
// on the order of minutes; this does not need to be fast.
#define CAPTURE_INTERVAL_MS 20000

// Region of interest, in pixels, within the captured frame
// (FRAME_WIDTH x FRAME_HEIGHT, see main.cpp). Crops to the track-name
// field on the XDJ unit's Normal playback screen; see
// docs/xdj_screen_reference.md. Calibrate against the physical camera
// mount; these are placeholder values.
#define ROI_X 80
#define ROI_Y 40
#define ROI_WIDTH 480
#define ROI_HEIGHT 40

// WiFi credentials for this rig.
#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-password"

// Backend base URL, no trailing slash, e.g. "https://192.168.1.50".
// When using Caddy locally, this must be https://
#define BACKEND_URL "https://192.168.1.50"

// Shared secret proving this rig is allowed to post captures. Must match
// the BACKEND_TOKEN environment variable the backend runs with, or every
// upload is rejected with 401. Generate a long random value; this is a
// secret, and config.h is gitignored for exactly this reason.
//
// It travels securely over HTTPS (via the Caddy reverse proxy) to protect 
// against eavesdropping on the network. See SECURITY.md.
#define BACKEND_TOKEN "change-me-to-a-long-random-value"

// Identifies this rig to the backend. One physical camera pointed at
// one XDJ unit gets one player_id; a 2-deck setup runs two rigs with
// different player_id values.
#define PLAYER_ID "player1"
