compile_commands.json
# This repo has no CMake build, so the Makefile line above only ever
# meant to catch a generated one in a build directory. It also matched
# the hand-authored root Makefile from the agents template, which is
# why that file was silently dropped from every `git add -A` since it
# was added. Un-ignore it explicitly.
!/Makefile

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# PlatformIO
firmware/.pio/
firmware/.dummy/
firmware/managed_components/
firmware/sdkconfig.defaults
firmware/sdkconfig.*

# secrets, never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
# firmware secrets, never commit real WiFi credentials or backend URLs
firmware/src/config.h

# Python
__pycache__/
*.pyc
server/.venv/
ml/.venv/

# backend runtime output, not source
server/output/

# generated/derived ml data and models, not source; rebuild via
# prepare_chars.py, synth.py, train.py, convert.py
ml/dataset/chars/
ml/model_output/
firmware/models/
